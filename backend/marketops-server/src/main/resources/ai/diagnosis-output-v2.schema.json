{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketops:ai:diagnosis-output:2",
  "title": "MarketOps diagnostic output v2",
  "description": "Advisory claims only. Runtime additionally bounds total UTF-8 bytes to 65536, depth to 8, rejects instruction/secret-shaped text, and resolves every reference against the exact authorized projection.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "facts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "inferences": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/inference"
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/unknown"
      }
    }
  },
  "required": [],
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
          }
        },
        "findingRefs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
          }
        }
      },
      "required": [
        "statement"
      ],
      "anyOf": [
        {
          "required": [
            "evidenceRefs"
          ],
          "properties": {
            "evidenceRefs": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "findingRefs"
          ],
          "properties": {
            "findingRefs": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
          }
        },
        "findingRefs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
          }
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "counterEvidence": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            }
          ]
        }
      },
      "required": [
        "statement",
        "confidence",
        "counterEvidence"
      ]
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
          }
        },
        "findingRefs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
          }
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "actionCapability": {
          "enum": [
            "PRICE_CHANGE",
            "RESOLVE_MAPPING",
            "RESTOCK_REVIEW",
            "LISTING_CONTENT_REVIEW",
            "ADVERTISING_REVIEW",
            "COST_DATA_REVIEW"
          ]
        },
        "proposedParameters": {
          "type": "object"
        },
        "expectedEffect": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "metric": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "\\S"
                },
                "direction": {
                  "enum": [
                    "INCREASE",
                    "DECREASE",
                    "STABILIZE"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "\\S"
                }
              },
              "required": [
                "metric",
                "direction",
                "rationale"
              ]
            }
          ]
        },
        "risk": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "level": {
                  "enum": [
                    "LOW",
                    "MEDIUM",
                    "HIGH"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "\\S"
                }
              },
              "required": [
                "level",
                "description"
              ]
            }
          ]
        },
        "validationWindowDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      },
      "required": [
        "statement",
        "actionCapability",
        "expectedEffect",
        "risk",
        "validationWindowDays"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "actionCapability": {
                "const": "PRICE_CHANGE"
              }
            }
          },
          "then": {
            "properties": {
              "proposedParameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "targetPrice": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 100000000000000,
                    "multipleOf": 0.0001
                  },
                  "currencyCode": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  }
                },
                "required": [
                  "targetPrice",
                  "currencyCode"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "proposedParameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reviewFocus": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "\\S"
                  }
                },
                "required": []
              }
            }
          }
        }
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "missingFact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "whyItMatters": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "nextEvidence": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            }
          ]
        }
      },
      "required": [
        "statement",
        "missingFact",
        "whyItMatters",
        "nextEvidence"
      ]
    }
  }
}
