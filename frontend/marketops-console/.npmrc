# Installs are reproducible or they fail.
#
# save-exact keeps a new dependency pinned to the version that was reviewed,
# rather than to a range that resolves differently on the next machine.
# engine-strict turns the Node range declared in package.json into a refusal
# instead of a warning, so a build never silently uses a runtime nobody tested.
save-exact=true
engine-strict=true
fund=false
audit=false
