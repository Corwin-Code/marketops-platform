# Names of the console's local settings. Values are written by `make env-init`
# into .env.local, which Git ignores.
#
# Only variables carrying the VITE_MARKETOPS_ prefix reach the browser bundle.
# That prefix is configured in vite.config.ts and asserted by a test, because a
# broader prefix would place every variable of the shell into a public artefact.
#
# Neither value below is a secret. The console has no credential of its own; it
# talks to a backend on the loopback interface.

VITE_MARKETOPS_API_BASE_URL=
VITE_MARKETOPS_ENVIRONMENT=
