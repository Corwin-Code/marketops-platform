+    @Test void incompleteRetainedCoverageRemainsUnknownInTheActualReaderInsteadOfInventingZeroSpareCapacity() throws Exception {
+        var migration=new DriverManagerDataSource(DATABASE.getJdbcUrl(),TestDatabase.migrationRole(),TestDatabase.migrationPassword());
+        var own=AdvertisingR1Fixture.seed(migration);
+        assertThat(operations.exposure(own.id("organization")).envelopes().getFirst()
+                .axes().get("affectedRetainedSalesShare").state()).isEqualTo("AVAILABLE");
+        seed.sql("""
+                INSERT INTO ledger.return_quality_evidence_snapshot
+                SELECT (jsonb_populate_record(NULL::ledger.return_quality_evidence_snapshot,to_jsonb(prior)||jsonb_build_object(
+                    'id',gen_random_uuid(),'supersedes_snapshot_id',prior.id,'accepted_at',clock_timestamp(),
+                    'retained_coverage','INCOMPLETE','evidence_reference','fixture://incomplete-retained-coverage'))).*
+                FROM ledger.return_quality_evidence_snapshot prior WHERE platform_listing_variant_id=:listing
+                  AND NOT EXISTS(SELECT 1 FROM ledger.return_quality_evidence_snapshot newer WHERE newer.supersedes_snapshot_id=prior.id)
+                """).param("listing",own.id("listingVariant")).update();
+        var read=operations.exposure(own.id("organization"));
+        assertThat(read.resolved()).isTrue(); // The envelope exists; one independent measurement is unknown.
+        var measured=read.envelopes().getFirst();var sales=measured.axes().get("affectedRetainedSalesShare");
+        assertThat(sales.state()).isEqualTo("UNKNOWN");assertThat(sales.usage()).isNull();
+        assertThat(sales.companySales()).isNull();assertThat(sales.affectedSales()).isNull();
+        assertThat(sales.limit()).isEqualByComparingTo("1");
+        assertThat(measured.reasons()).contains("RETAINED_SALES_SHARE_UNRESOLVED");
+        assertThat(measured.axes().get("activeInterventions").usage()).isZero();
+    }
