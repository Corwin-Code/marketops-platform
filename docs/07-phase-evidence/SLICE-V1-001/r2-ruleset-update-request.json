          {"context": "frontend-typecheck", "integration_id": 15368},
          {"context": "frontend-test", "integration_id": 15368},
          {"context": "frontend-build", "integration_id": 15368},
          {"context": "dependency-review", "integration_id": 15368},
          {"context": "codeql-java", "integration_id": 15368},
          {"context": "codeql-typescript", "integration_id": 15368},
          {"context": "infrastructure-validation", "integration_id": 15368}
        ]
      }
    }
  ]
