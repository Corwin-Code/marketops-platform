# MarketOps Russia — local development environment template.
#
# You do not copy this file. Run `make env-init`, which writes `.env.local` with
# randomly generated local-only values. This file documents variable NAMES only.
#
# Every assignment below is intentionally blank. A value committed here would be
# published, because this repository is public during pre-production.
#
# Database role names are deliberately absent: `marketops_migration` and
# `marketops_app` are non-secret constants defined in checked-in configuration,
# not local values.

# Superuser password used only by the local database container bootstrap.
MARKETOPS_POSTGRES_SUPERUSER_PASSWORD=

# Password for the Flyway migration role (marketops_migration).
MARKETOPS_DB_MIGRATION_PASSWORD=

# Password for the application runtime role (marketops_app).
MARKETOPS_DB_APP_PASSWORD=

# Host port the local PostgreSQL container is published on.
MARKETOPS_DB_PORT=
